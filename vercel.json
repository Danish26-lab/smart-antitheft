{
  "version": 2,
  "builds": [{"src": "api/index.py", "use": "@vercel/python", "config": {"maxLambdaSize": "50mb"}}],
  "rewrites": [{"source": "/(.*)", "destination": "/api/index.py"}],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "Access-Control-Allow-Origin", "value": "https://antitheft-frontend-2.vercel.app"},
      {"key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH"},
      {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, Accept"},
      {"key": "Access-Control-Allow-Credentials", "value": "true"},
      {"key": "Access-Control-Max-Age", "value": "3600"}
    ]}
  ],
  "env": {"FLASK_APP": "backend/app.py", "PYTHONPATH": "backend", "VERCEL": "1"}
}
